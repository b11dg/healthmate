generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  hashedPassword String
  createdAt      DateTime       @default(now())
  profile        Profile?
  weightLogs     WeightLog[]
  habitLogs      HabitLog[]
  mealLogs       MealLog[]
  labReports     LabReport[]
  conversations  Conversation[]
}

model Profile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         String?
  heightCm     Int?
  weightKg     Float?
  allergies    String?
  restrictions String?
  updatedAt    DateTime @updatedAt
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Float
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model HabitLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  waterMl    Int?
  sleepHours Float?

  @@unique([userId, date])
}

model MealLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  calories Int
  proteinG Float?
  fatG     Float?
  carbsG   Float?
  eatenAt  DateTime @default(now())

  @@index([userId, eatenAt])
}

enum LabReportStatus {
  processing
  done
  error
}

enum LabResultFlag {
  low
  normal
  high
  unknown
}

model LabReport {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  status       LabReportStatus @default(processing)
  errorMessage String?
  reportDate   DateTime?       @db.Date
  createdAt    DateTime        @default(now())
  results      LabResult[]

  @@index([userId, createdAt])
}

model LabResult {
  id          String        @id @default(cuid())
  labReportId String
  labReport   LabReport     @relation(fields: [labReportId], references: [id], onDelete: Cascade)
  name        String
  value       Float
  unit        String
  refLow      Float?
  refHigh     Float?
  flag        LabResultFlag @default(unknown)

  @@index([labReportId])
}

enum ChatRole {
  user
  assistant
}

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  @@index([userId, createdAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// embedding is Unsupported("vector(768)") — pgvector has no native Prisma
// scalar yet; column is created by `db push` from the raw type below, reads
// and writes go through $queryRaw/$executeRaw (see src/lib/knowledge.ts).
model KnowledgeChunk {
  id          String                      @id @default(cuid())
  content     String
  sourceLabel String?
  embedding   Unsupported("vector(768)")?
}
