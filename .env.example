# Скопируйте в .env.local и заполните реальными значениями (файл .env.local в .gitignore, в репозиторий не попадёт)

# Supabase → Project Settings → Database → Connection string (URI, режим "Transaction")
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Supabase → Project Settings → Database → Connection string (URI, режим "Session", порт 5432)
# Нужен для `prisma db push`/`migrate` — PgBouncer в transaction-mode не поддерживает shadow DB
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=""

# Локально: http://localhost:3000 — на Vercel не нужен, подставляется автоматически
NEXTAUTH_URL="http://localhost:3000"

# Google AI Studio (aistudio.google.com/apikey) — бесплатный тир, без карты
GEMINI_API_KEY=""

# Supabase → Project Settings → API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
